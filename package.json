{
  "name": "boh",
  "version": "0.1.0",
  "private": true,
  "description": "boh, a static web page.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "build:web": "node scripts/build-web.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.17.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0"
  }
}
